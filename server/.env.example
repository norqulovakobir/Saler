# Postgres manzili. Supabase: Connect -> Session pooler (port 5432) manzili
DATABASE_URL=postgres://postgres:saler@localhost:5433/saler
# Hetzner + PgBouncer uchun: postgres://saler:PAROL@127.0.0.1:6432/saler
DATABASE_SSL=false
DB_POOL_MAX=8
DB_POOL_IDLE_MS=30000
DB_CONNECT_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=25000
DB_STATEMENT_TIMEOUT_MS=20000
DB_POOL_MAX_USES=7500
PORT=3000
# Admin panel paroli (/api/admin/login)
ADMIN_PASSWORD=admin
# AI yordamchi: Google Gemini (ixtiyoriy; bo'lmasa AI o'chiq, qolgan hamma narsa ishlaydi)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
# Gemini o'rniga Claude ishlatish uchun GEMINI_API_KEY ni bo'sh qoldirib, shularni to'ldiring
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
# Rasmlar uchun Supabase Storage (ixtiyoriy; bo'lmasa rasmlar bazadagi photos jadvalida saqlanadi)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=photos
# Email tasdiqlash kodlari: EmailJS (https://dashboard.emailjs.com)
# Shablonda "To Email" = {{to_email}}, matnda {{code}} bo'lsin. Account > Security'da
# "Allow EmailJS API for non-browser applications" yoqilsin. Bo'sh qolsa, test rejimida kod server logida va javobda ko'rinadi.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
