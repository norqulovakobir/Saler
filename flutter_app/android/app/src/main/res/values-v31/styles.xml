<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ tizim splash ekrani: ilova foni, markazda logo, pastda brend yozuvi -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/launch_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/launch_bg</item>
        <item name="android:windowSplashScreenAnimationDuration">400</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
