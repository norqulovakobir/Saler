{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "saler-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-16",
  "keep_vars": true,
  // Ulashish havolasi (/p/<id>, /s/<id>) shu manzilga o'tkazadi
  "vars": {
    "WEB_BASE": "https://saler-web.onrender.com",
    // Emailda "Kimdan" qatorida ko'rinadigan nom. Dashboard'da eski qiymat
    // ("Saler AI") qolib ketmasligi uchun shu yerda aniq belgilanadi.
    "BREVO_SENDER_NAME": "Rydex"
  },
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    }
  },
  // Rasmlar D1 BLOB o'rniga R2 ga yoziladi (lib.js: r2Enabled -> env.MEDIA).
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "saler-media"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "saler-db",
      "database_id": "97c4adfc-5bd0-435d-abe9-545f618893b5"
    }
  ],
  "triggers": {
    "crons": ["15 3 * * *"]
  }
}
